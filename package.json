{
  "name": "mcp-server",
  "version": "0.2.1",
  "description": "MCP server with packaged tools",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node mcpServer.js",
    "start:http": "node mcpServer.js --http",
    "start:http:local:integration": "nodemon --watch .env --watch mcpServer.js --watch index.js --watch lib --watch tools --watch commands -x node mcpServer.js --http --send-integration-key",
    "generate": "node codegen/generate.js",
    "sync-spec": "node scripts/sync-spec.mjs",
    "list-tools": "node index.js tools",
    "export:oss": "node scripts/internal/export-oss.mjs",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "^13.1.0",
    "express": "5.2.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^26.13.1",
    "npm": ">=11.16.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "nodemon": "3.1.14"
  }
}
